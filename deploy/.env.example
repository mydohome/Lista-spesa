# Copia in deploy/.env e valorizza prima di "docker compose up -d"
# NON committare mai il file .env reale (è già in .gitignore).
#
# IMPORTANTE: la password viene inserita in una stringa di connessione stile
# URL (postgresql://user:password@host...). Evita i caratteri speciali
# % @ : / ? # e gli spazi: alcuni (come %) vengono interpretati come
# percent-encoding e causano un disallineamento silenzioso tra la password
# salvata in Postgres e quella usata dal backend per connettersi.
# Usa solo lettere e numeri, anche una stringa lunga va benissimo.

POSTGRES_USER=spesa
POSTGRES_PASSWORD=cambia_questa_password_solo_alfanumerica
POSTGRES_DB=spesa_db

# Opzionale: normalizzazione prodotti via Claude Haiku (backend/app/ai_normalize.py).
# Lascia vuota per usare solo il matching locale gratuito.
ANTHROPIC_API_KEY=
