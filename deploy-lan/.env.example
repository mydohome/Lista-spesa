# Copia in deploy-lan/.env e valorizza prima di "docker compose up -d"
# NON committare mai il file .env reale (è già in .gitignore).
#
# IMPORTANTE: evita i caratteri % @ : / ? # e gli spazi nella password
# (vengono interpretati come percent-encoding nella stringa di connessione
# e causano un disallineamento tra password salvata e password usata dal
# backend). Usa solo lettere e numeri.

POSTGRES_USER=spesa
POSTGRES_PASSWORD=cambia_questa_password_solo_alfanumerica
POSTGRES_DB=spesa_db

# Opzionale: normalizzazione prodotti via Claude Haiku (backend/app/ai_normalize.py).
ANTHROPIC_API_KEY=
